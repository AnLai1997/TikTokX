<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Labels and footers are keys into <lang>.lproj/Localizable.strings; "symbol"/"symbolColor" draw the row icon.
     No PostNotification: the controller writes the notification state TikTok reads, then posts it. -->
<plist version="1.0">
<dict>
	<key>title</key>
	<string>TikTokX</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>GENERAL_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>ENABLE</string>
			<key>symbol</key>
			<string>power</string>
			<key>symbolColor</key>
			<string>#0A59F7</string>
			<key>key</key>
			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.tiktokx</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>SECTION_PLAYBACK</string>
			<key>footerText</key>
			<string>BACKGROUND_AUDIO_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>BACKGROUND_AUDIO</string>
			<key>symbol</key>
			<string>headphones</string>
			<key>symbolColor</key>
			<string>#E8457C</string>
			<key>key</key>
			<string>backgroundAudio</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.tiktokx</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>AUTO_NEXT_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>AUTO_NEXT</string>
			<key>symbol</key>
			<string>arrow.down.circle.fill</string>
			<key>symbolColor</key>
			<string>#00A6B2</string>
			<key>key</key>
			<string>autoNext</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.tiktokx</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>SECTION_DISPLAY</string>
			<key>footerText</key>
			<string>REMOTE_SCROLL_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>REMOTE_SCROLL</string>
			<key>symbol</key>
			<string>forward.end.fill</string>
			<key>symbolColor</key>
			<string>#0A59F7</string>
			<key>key</key>
			<string>remoteScroll</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.tiktokx</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>CLEAR_DISPLAY_FOOTER</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>CLEAR_DISPLAY</string>
			<key>symbol</key>
			<string>eye.slash.fill</string>
			<key>symbolColor</key>
			<string>#8A47E8</string>
			<key>key</key>
			<string>clearDisplay</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.tiktokx</string>
		</dict>
	</array>
</dict>
</plist>
